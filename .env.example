# Obtain partner API credentials from Alza Trade. These are NOT retail login credentials.
ALZA_CLIENT_ID=
ALZA_CLIENT_SECRET=
ALZA_SCOPE=marketplace_public
ALZA_LANGUAGE=cs
ALZA_BASE_URL=https://portalapi.alza.cz
ALZA_TOKEN_URL=https://identity.alza.cz/connect/token
ALZA_TIMEOUT_SECONDS=20
ALZA_MAX_RETRIES=2
ALZA_MAX_RESPONSE_BYTES=20000000
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT=http
# Optional on a trusted private network. Required by compose.komodo.yaml.
# Generate with: uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
MCP_API_KEY=
MCP_PUBLISHED_PORT=8019
IMAGE_TAG=latest
